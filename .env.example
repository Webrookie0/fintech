# Paste ONE of these free-tier keys — the judge picks the first provider that
# has a key. With none set, the judge uses a deterministic heuristic.
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Admin token for the dashboard's kill switch + demo buttons.
# SET THIS to something non-public before deploying.
GUARDIAN_ADMIN_TOKEN=demo

# Supervision mode: enforce | watch | ask.
#   watch   = NEVER blocks tools, only toasts (safe default)
#   enforce = paused/terminated sessions block spendy tools (strict)
#   ask     = blocks on pause, but "Allow for 5 min" on the dashboard overrides
GUARDIAN_MODE=watch

# Bulletproof escape hatch: GUARDIAN_BYPASS=1 makes the opencode plugin a no-op
# on its NEXT start. If you ever feel locked out, set this and restart once.
# GUARDIAN_BYPASS=1

# Point the plugin at a deployed Guardian instead of localhost.
# GUARDIAN_URL=https://guardian.onrender.com
