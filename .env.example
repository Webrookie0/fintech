# Paste ONE of these free-tier keys — the judge picks the first provider that
# has a key. With none set, the judge uses a deterministic heuristic.
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Admin token for the dashboard's kill switch + demo buttons.
# SET THIS to something non-public before deploying.
GUARDIAN_ADMIN_TOKEN=demo
